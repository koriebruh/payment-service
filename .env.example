APP_NAME=payment-service
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=DEBUG

# Database Configuration
DB_HOST=payment-service-postgres
DB_PORT=5432
DB_NAME=payment_db
DB_USER=payment_user
DB_PASSWORD=payment_password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE=1m

# Midtrans Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PROD=false
MIDTRANS_TIMEOUT=10s
MIDTRANS_CB_MAX_REQUESTS=3
MIDTRANS_CB_INTERVAL=1m
MIDTRANS_CB_TIMEOUT=30s

# Kafka Configuration
KAFKA_BROKERS=payment-service-kafka:9092
KAFKA_TOPIC=payment.payment.settled

# Redis Configuration
REDIS_HOST=payment-service-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Observability (OpenTelemetry)
OTEL_ENABLED=true
OTEL_ENDPOINT=payment-service-alloy:4317
OTEL_SERVICE_NAME=payment-service
OTEL_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=true
OTEL_SAMPLE_RATE=1.0

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
